# LLM API KEYS
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# LLM runtime selection
# Supported values: ollama | openai | anthropic | google | lmstudio
LLM="ollama"

# Optional model override for selected provider
# Examples:
# - ollama: gemma4:31b-cloud
# - openai: gpt-4o
# - anthropic: claude-3-5-sonnet-20240620
# - google: gemma-4-31b-it
# - lmstudio: local-model
LLM_MODEL="gpt-oss:120b-cloud"

# Optional provider endpoints
# Local http://localhost:11434 (Ollama installation required)
# Cloud https://ollama.com (Ollama installation NOT required)
OLLAMA_BASE_URL="https://ollama.com"
OLLAMA_API_KEY=""
LMSTUDIO_BASE_URL="http://localhost:1234/v1"

# AGENT'S PARAMS
OBJECTIVE=""
HEADLESS="false"
DEBUG_LOCATORS="true"
VERBOSE="false"

AUTO_SEND_DONE_REPORT="false"

# MAILTRAP
MAILTRAP_TOKEN=""
MAIL_FROM=""

# STANDARD SMTP
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# GITHUB/GITLAB WEBHOOKS
WEBHOOK_PORT=9000

# GitHub: used to validate X-Hub-Signature-256 (HMAC SHA-256)
GITHUB_WEBHOOK_SECRET=""

# GitLab cloud/self-managed generic endpoint: /webhooks/gitlab
GITLAB_WEBHOOK_TOKEN=""

# GitLab on-prem dedicated endpoint: /webhooks/gitlab/onprem
# If empty, it falls back to GITLAB_WEBHOOK_TOKEN
GITLAB_ONPREM_WEBHOOK_TOKEN=""

# Optional allowlist prefix for on-prem projects, e.g. https://gitlab.mycompany.local
GITLAB_ONPREM_BASE_URL=""

# Optional: max graph recursion for each webhook-triggered run
RECURSION_LIMIT=100